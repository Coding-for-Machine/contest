# ===== LOGIN =====
msgid "Log in"
msgstr "Kirish"

msgid "Username"
msgstr "Foydalanuvchi nomi"

msgid "Password"
msgstr "Parol"

msgid "Welcome back to"
msgstr "Xush kelibsiz"

msgid "Forgotten your password or username?"
msgstr "Parolni unutdingizmi?"

msgid "Please enter the correct %(username)s and password for a staff account. Note that both fields may be case-sensitive."
msgstr "Xodim hisobi uchun to'g'ri %(username)s va parolni kiriting. Ikkala maydon ham katta-kichik harflarga sezgir bo'lishi mumkin."

msgid "Your username and password didn't match. Please try again."
msgstr "Foydalanuvchi nomi yoki parol noto'g'ri. Qayta urinib ko'ring."

# ===== LOGOUT =====
msgid "Logged out"
msgstr "Tizimdan chiqildi"

msgid "You have been successfully logged out from the administration"
msgstr "Boshqaruv panelidan muvaffaqiyatli chiqdingiz"

msgid "Thanks for spending some quality time with the web site today."
msgstr "Bugun vaqt ajratganingiz uchun rahmat."

msgid "Log in again"
msgstr "Qayta kirish"

# ===== DELETE ACTION (changelist dropdown) =====
msgid "Delete selected %(verbose_name_plural)s"
msgstr "Tanlangan %(verbose_name_plural)s ni o'chirish"

msgid "Successfully deleted %(count)d %(items)s."
msgstr "%(count)d ta %(items)s muvaffaqiyatli o'chirildi."

msgid "Delete multiple objects"
msgstr "Bir nechta ob'ektni o'chirish"

msgid "Cannot delete %(name)s"
msgstr "%(name)s ni o'chirib bo'lmaydi"

# ===== DELETE CONFIRMATION PAGE =====
msgid "Are you sure you want to delete the %(object_name)s \"%(escaped_object)s\"? All of the following related items will be deleted:"
msgstr "Haqiqatdan ham %(object_name)s \"%(escaped_object)s\" ni o'chirib tashlamoqchimisiz? Quyidagi barcha bog'liq ma'lumotlar ham o'chib ketadi:"

msgid "Deleting the %(object_name)s '%(escaped_object)s' would result in deleting related objects, but your account doesn't have permission to delete the following types of objects:"
msgstr "\"%(escaped_object)s\" ob'ektini o'chirish bog'liq ob'ektlarni ham o'chirishni talab qiladi, lekin sizning hisobingizda quyidagi turdagi ob'ektlarni o'chirish ruxsati yo'q:"

msgid "Deleting the %(object_name)s '%(escaped_object)s' would require deleting the following protected related objects:"
msgstr "\"%(escaped_object)s\" ob'ektini o'chirish quyidagi himoyalangan bog'liq ob'ektlarni ham o'chirishni talab qiladi:"

msgid "Are you sure you want to delete the selected %(objects_name)s? All of the following objects and their related items will be deleted:"
msgstr "Haqiqatdan ham tanlangan %(objects_name)s ni o'chirib tashlamoqchimisiz? Quyidagi barcha ob'ektlarax bor ularning bog'liq ma'lumotlari o'chib ketadi:"

msgid "Deleting the selected %(objects_name)s would result in deleting related objects, but your account doesn't have permission to delete the following types of objects:"
msgstr "Tanlangan %(objects_name)s ni o'chirish bog'liq ob'ektlarni ham o'chirishni talab qiladi, lekin sizning hisobingizda quyidagi turdagi ob'ektlarni o'chirish ruxsati yo'q:"

msgid "Deleting the selected %(objects_name)s would require deleting the following protected related objects:"
msgstr "Tanlangan %(objects_name)s ni o'chirish quyidagi himoyalangan bog'liq ob'ektlarni o'chirishni talab qiladi:"

msgid "Objects"
msgstr "Ob'ektlar"

msgid "No, take me back"
msgstr "Yo'q, bekor qilish"

msgid "Yes, I'm sure"
msgstr "Ha, o'chirilsin!"

